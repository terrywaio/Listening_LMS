      "turnId": "t002",
      "text": "Customer support, how may I help you?"
    },
    {
      "id": "s003",
      "start": 6.71,
      "end": 10.55,
      "speakerId": "customer",
      "speaker": "来电者",
      "turnId": "t003",
      "text": "Well, my computer keeps overheating and shutting down."
    },
    {
      "id": "s004",
      "start": 10.55,
      "end": 13.33,
      "speakerId": "support",
      "speaker": "客服人员",
      "turnId": "t004",
      "text": "Have you checked if the fans are working properly?"
    },
    {
      "id": "s005",
      "start": 13.33,
      "end": 15.88,
      "speakerId": "support",
      "speaker": "客服人员",
      "turnId": "t004",
      "text": "Dust can accumulate and block airflow."
    },
    {
      "id": "s006",
      "start": 15.88,
      "end": 17.98,
      "speakerId": "customer",
      "speaker": "来电者",
      "turnId": "t005",
      "text": "I haven't looked at that."
    },
    {
      "id": "s007",
      "start": 17.98,
      "end": 23.72,
      "speakerId": "support",
      "speaker": "客服人员",
      "turnId": "t006",
      "text": "You can get a can of compressed air and spray it into the vents and the fans to blow out the dust."
    },
    {
      "id": "s008",
      "start": 23.72,
      "end": 25.97,
      "speakerId": "customer",
      "speaker": "来电者",
      "turnId": "t007",
      "text": "Okay, I'll try that."
