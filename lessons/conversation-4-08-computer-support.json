      "id": "s009",
      "start": 25.97,
      "end": 28.33,
      "speakerId": "support",
      "speaker": "客服人员",
      "turnId": "t008",
      "text": "Hopefully that'll take care of the problem."
    },
    {
      "id": "s010",
      "start": 28.33,
      "end": 32.07,
      "speakerId": "support",
      "speaker": "客服人员",
